# Copy to deploy/.env.pairbeat on the chosen host. Never commit real values.
PAIRBEAT_BOT_TOKEN=
PAIRBEAT_LINK_CODE=
PAIRBEAT_OWNER_KEY=
# Fine-grained token for this repository: Contents write, Actions write, Variables read.
GITHUB_TOKEN=
GITHUB_REPOSITORY=7dsolv/konaet-atlas
# Optional acoustic identification; requires your own AcoustID application key.
ACOUSTID_API_KEY=
