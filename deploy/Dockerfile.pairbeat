FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends libchromaprint-tools ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY integrations/requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.txt
COPY integrations /app/integrations
USER 10001:10001
HEALTHCHECK --interval=60s --start-period=120s --timeout=5s CMD python -c "import json,time;assert time.time()-json.load(open('/tmp/pairbeat-health.json'))['last_success']<600"
CMD ["python", "-m", "integrations.pairbeat_service", "--interval", "20"]
